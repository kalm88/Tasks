<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PunchlistApp.Views"
       x:Class="PunchlistApp.AppShell"
       Shell.NavBarHasShadow="True"
       Shell.BackgroundColor="{StaticResource PrimaryColor}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White">

    <!-- Auth flow (no tab bar) -->
    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Shell.TabBarIsVisible="False" />

    <!-- Main app -->
    <ShellContent Route="projects"
                  ContentTemplate="{DataTemplate views:ProjectListPage}"
                  Shell.TabBarIsVisible="False" />

</Shell>
