<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="PrimaryColor">#1565C0</Color>
    <Color x:Key="PrimaryDark">#003c8f</Color>
    <Color x:Key="PrimaryLight">#5e92f3</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="OnSurface">#212121</Color>
    <Color x:Key="OnSurfaceVariant">#757575</Color>

    <Color x:Key="StatusOpen">#2196F3</Color>
    <Color x:Key="StatusInProgress">#FF9800</Color>
    <Color x:Key="StatusNeedsReview">#9C27B0</Color>
    <Color x:Key="StatusComplete">#4CAF50</Color>

    <Color x:Key="PriorityLow">#4CAF50</Color>
    <Color x:Key="PriorityMedium">#FF9800</Color>
    <Color x:Key="PriorityHigh">#F44336</Color>
    <Color x:Key="PriorityUrgent">#9C27B0</Color>

    <Color x:Key="ErrorColor">#B00020</Color>
    <Color x:Key="DividerColor">#E0E0E0</Color>

</ResourceDictionary>
