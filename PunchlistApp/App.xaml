<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:PunchlistApp.Converters"
             x:Class="PunchlistApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters available app-wide -->
            <conv:StatusToColorConverter x:Key="StatusToColor" />
            <conv:PriorityToColorConverter x:Key="PriorityToColor" />
            <conv:StatusToLabelConverter x:Key="StatusToLabel" />
            <conv:PriorityToLabelConverter x:Key="PriorityToLabel" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
