<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PunchlistApp.ViewModels"
             xmlns:models="clr-namespace:PunchlistApp.Models"
             x:Class="PunchlistApp.Views.ProjectListPage"
             x:DataType="vm:ProjectListViewModel"
             Title="Projects"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding CreateProjectCommand}" Order="Primary" Priority="0" />
        <ToolbarItem Text="Sign Out" Command="{Binding SignOutCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">

        <!-- List -->
        <RefreshView Grid.Row="0"
                     Command="{Binding LoadProjectsCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Projects}"
                            EmptyView="No projects yet. Tap + to create one."
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Project">
                        <Frame Style="{StaticResource CardFrame}" Margin="16,8,16,0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectListViewModel}}, Path=OpenProjectCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}" Style="{StaticResource HeadlineLabel}" FontSize="17" />
                                    <Label Text="{Binding Description}" Style="{StaticResource SubtitleLabel}"
                                           IsVisible="{Binding Description, Converter={StaticResource BoolToVisibility}}"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding CreatedAt, StringFormat='Created {0:MMM dd, yyyy}'}"
                                           Style="{StaticResource SubtitleLabel}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource OnSurfaceVariant}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="1"
                Text="+ New Project"
                Command="{Binding CreateProjectCommand}"
                Style="{StaticResource PrimaryButton}"
                Margin="16"
                HorizontalOptions="Fill" />

    </Grid>

</ContentPage>
