<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PunchlistApp.ViewModels"
             x:Class="PunchlistApp.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Create Account"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="0">

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                   Margin="0,16,0,12"
                   FontSize="13" />

            <Label Text="NAME" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False" Margin="0,0,0,16">
                <Entry Placeholder="Your full name"
                       Text="{Binding DisplayName}"
                       Style="{StaticResource TextEntry}"
                       Margin="12,0" />
            </Frame>

            <Label Text="EMAIL" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False" Margin="0,0,0,16">
                <Entry Placeholder="you@example.com"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       Style="{StaticResource TextEntry}"
                       Margin="12,0" />
            </Frame>

            <Label Text="PASSWORD" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False" Margin="0,0,0,32">
                <Entry Placeholder="Min 6 characters"
                       Text="{Binding Password}"
                       IsPassword="True"
                       Style="{StaticResource TextEntry}"
                       Margin="12,0" />
            </Frame>

            <Button Text="Create Account"
                    Command="{Binding RegisterCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Margin="0,0,0,16" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" />

            <Button Text="Already have an account? Sign In"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource PrimaryColor}"
                    Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
