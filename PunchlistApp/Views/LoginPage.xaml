<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PunchlistApp.ViewModels"
             x:Class="PunchlistApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title=""
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="0" VerticalOptions="Center">

            <!-- Logo / Brand -->
            <Label Text="Punchlist"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8" />
            <Label Text="Jobsite issue tracking"
                   Style="{StaticResource SubtitleLabel}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,48" />

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                   Margin="0,0,0,12"
                   FontSize="13" />

            <!-- Email -->
            <Label Text="EMAIL" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False" Margin="0,0,0,16">
                <Entry Placeholder="you@example.com"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       Style="{StaticResource TextEntry}"
                       Margin="12,0" />
            </Frame>

            <!-- Password -->
            <Label Text="PASSWORD" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False" Margin="0,0,0,24">
                <Entry Placeholder="••••••••"
                       Text="{Binding Password}"
                       IsPassword="True"
                       Style="{StaticResource TextEntry}"
                       Margin="12,0" />
            </Frame>

            <!-- Login button -->
            <Button Text="Sign In"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Margin="0,0,0,16" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center"
                               Margin="0,0,0,16" />

            <!-- Register link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Don't have an account?" Style="{StaticResource SubtitleLabel}" VerticalOptions="Center" />
                <Button Text="Register"
                        Command="{Binding GoToRegisterCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="36"
                        Padding="12,0" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
