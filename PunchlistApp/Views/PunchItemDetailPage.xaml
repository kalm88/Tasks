<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PunchlistApp.ViewModels"
             xmlns:models="clr-namespace:PunchlistApp.Models"
             x:Class="PunchlistApp.Views.PunchItemDetailPage"
             x:DataType="vm:PunchItemDetailViewModel"
             Title="{Binding Item.Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="PDF" Command="{Binding SharePdfCommand}" Order="Primary" />
        <ToolbarItem Text="Email" Command="{Binding ShareEmailCommand}" Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding Item, Converter={StaticResource BoolToVisibility}}">

            <!-- Status + Priority pills -->
            <HorizontalStackLayout Spacing="8">
                <Frame BackgroundColor="{Binding Item.Status, Converter={StaticResource StatusToColor}}"
                       CornerRadius="12" Padding="12,6" HasShadow="False" BorderColor="Transparent">
                    <Label Text="{Binding Item.Status, Converter={StaticResource StatusToLabel}}"
                           Style="{StaticResource PillLabel}" />
                </Frame>
                <Frame BackgroundColor="{Binding Item.Priority, Converter={StaticResource PriorityToColor}}"
                       CornerRadius="12" Padding="12,6" HasShadow="False" BorderColor="Transparent">
                    <Label Text="{Binding Item.Priority, Converter={StaticResource PriorityToLabel}}"
                           Style="{StaticResource PillLabel}" />
                </Frame>
            </HorizontalStackLayout>

            <!-- Details card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <!-- Issue -->
                    <Label Text="ISSUE" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding Item.IssueDescription}" Style="{StaticResource BodyLabel}" />

                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />

                    <!-- Work Required -->
                    <Label Text="WORK REQUIRED" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding Item.WorkRequired}" Style="{StaticResource BodyLabel}" />

                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />

                    <!-- Location -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Item.Location, Converter={StaticResource BoolToVisibility}}">
                        <Label Grid.Column="0" Text="LOCATION" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Item.Location}" Style="{StaticResource BodyLabel}" Margin="16,0,0,0" />
                    </Grid>

                    <!-- SKU -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Item.Sku, Converter={StaticResource BoolToVisibility}}">
                        <Label Grid.Column="0" Text="SKU" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Item.Sku}" Style="{StaticResource BodyLabel}" FontFamily="Monospace" Margin="16,0,0,0" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />

                    <!-- Assigned To -->
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="ASSIGNED TO" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Item.AssignedToUserName}" Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="CREATED BY" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Item.CreatedByUserName}" Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="CREATED" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Item.CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="DUE DATE" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Item.DueDate, StringFormat='{0:MMM dd, yyyy}'}" Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Photos -->
            <Label Text="PHOTOS" Style="{StaticResource SectionLabel}"
                   IsVisible="{Binding Item.PhotoUrls.Count, Converter={StaticResource BoolToVisibility}}" />
            <CollectionView ItemsSource="{Binding Item.PhotoUrls}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="120"
                            IsVisible="{Binding Item.PhotoUrls.Count, Converter={StaticResource BoolToVisibility}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Image Source="{Binding .}" WidthRequest="110" HeightRequest="110"
                               Aspect="AspectFill" Margin="0,0,8,0">
                            <Image.Clip>
                                <RoundRectangleGeometry Rect="0,0,110,110" CornerRadius="8" />
                            </Image.Clip>
                        </Image>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Change Status -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="CHANGE STATUS" Style="{StaticResource SectionLabel}" />
                    <CollectionView ItemsSource="{Binding Statuses}" ItemsLayout="HorizontalList" HeightRequest="44">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Status">
                                <Button Text="{Binding ., Converter={StaticResource StatusToLabel}}"
                                        BackgroundColor="{Binding ., Converter={StaticResource StatusToColor}}"
                                        TextColor="White"
                                        CornerRadius="20"
                                        Padding="12,8"
                                        Margin="0,0,8,0"
                                        FontSize="12"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PunchItemDetailViewModel}}, Path=UpdateStatusCommand}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Comments -->
            <Label Text="COMMENTS" Style="{StaticResource SectionLabel}" />
            <CollectionView ItemsSource="{Binding Comments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Comment">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="13"
                                           TextColor="{StaticResource OnSurface}" />
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd}'}"
                                           Style="{StaticResource SubtitleLabel}" FontSize="12" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Text}" Style="{StaticResource BodyLabel}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add comment -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding NewCommentText}"
                           Placeholder="Add a comment..."
                           Style="{StaticResource TextEntry}" />
                    <Button Grid.Column="1"
                            Text="Post"
                            Command="{Binding AddCommentCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="44"
                            Padding="16,0" />
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
