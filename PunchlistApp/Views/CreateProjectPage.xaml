<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PunchlistApp.ViewModels"
             x:Class="PunchlistApp.Views.CreateProjectPage"
             x:DataType="vm:CreateProjectViewModel"
             Title="New Project"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Create a Project" Style="{StaticResource HeadlineLabel}" />
            <Label Text="Examples: &quot;Home Remodel&quot;, &quot;Store Walk&quot;, &quot;Jobsite A&quot;"
                   Style="{StaticResource SubtitleLabel}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                   FontSize="13" />

            <Label Text="PROJECT NAME *" Style="{StaticResource SectionLabel}" Margin="0,8,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False">
                <Entry Text="{Binding Name}" Placeholder="e.g. Jobsite A"
                       Style="{StaticResource TextEntry}" Margin="12,0" />
            </Frame>

            <Label Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,8,0,4" />
            <Frame Padding="0" CornerRadius="8" BorderColor="{StaticResource DividerColor}" HasShadow="False">
                <Editor Text="{Binding Description}"
                        Placeholder="Brief project description"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="80"
                        Style="{StaticResource TextEditor}"
                        Margin="12,8" />
            </Frame>

            <Button Text="Create Project"
                    Command="{Binding CreateCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Margin="0,16,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
